{
  "name": "kui-vue-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "big.js": "^7.0.1",
    "cm6-theme-solarized-dark": "^0.2.0",
    "cm6-theme-solarized-light": "^0.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "hash-sum": "^2.0.0",
    "kui-icons": "^5.0.0",
    "kui-vue": "^6.2.1",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/big.js": "^7.0.0",
    "@types/hash-sum": "^1.0.2",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
